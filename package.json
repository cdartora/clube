{
  "name": "clube",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply clube --local",
    "db:migrate:remote": "wrangler d1 migrations apply clube --remote",
    "seed:admin": "node scripts/seed-admin.mjs",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.148.0"
  }
}
