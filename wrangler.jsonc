{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clube",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public"
  },
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clube",
      "database_id": "6e007bfa-35f5-4509-855c-844af898c38b",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "lingering-mouse-80e0.cloudflareaccess.com",
    "ACCESS_AUD": "ed2e55afc429f69998cbb83281c95cda28afcc5fb1a4162c99a2782b8f46c3b8",
    "CF_ACCOUNT_ID": "dcd03d86f33761b593db669aba821f8a",
    "ACCESS_GROUP_ID": "7a82b9ce-e3ad-4062-8dd1-ffe48905a6a4"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    // Staging: Worker `clube-staging`, com banco e grupo do Access próprios. Veja docs/deploy.md.
    // `vars` e `d1_databases` não são herdados do topo, então são repetidos aqui.
    "staging": {
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clube-staging",
          "database_id": "4125ca7a-6603-4c5b-8193-0f1e4ab62bd8",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "lingering-mouse-80e0.cloudflareaccess.com",
        "ACCESS_AUD": "d5e3949c5461e529598253ec75e758fcafbe95095e1ababa2c9f03a19c95e084",
        "CF_ACCOUNT_ID": "dcd03d86f33761b593db669aba821f8a",
        // Grupo separado (ex.: clube-staging): convites feitos no staging não liberam ninguém na produção.
        "ACCESS_GROUP_ID": "cdb8acf4-564f-4cb1-923a-60a765a20b26"
      },
      // Previews (`wrangler preview --env staging`, uma por branch). Não herdam nada de cima:
      // repetem o banco e as variáveis do staging. Mantenha os valores iguais aos de `env.staging`.
      "previews": {
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "clube-staging",
            "database_id": "4125ca7a-6603-4c5b-8193-0f1e4ab62bd8",
            "migrations_dir": "drizzle/migrations"
          }
        ],
        "vars": {
          "ACCESS_TEAM_DOMAIN": "lingering-mouse-80e0.cloudflareaccess.com",
          "ACCESS_AUD": "d5e3949c5461e529598253ec75e758fcafbe95095e1ababa2c9f03a19c95e084",
          "CF_ACCOUNT_ID": "dcd03d86f33761b593db669aba821f8a",
          "ACCESS_GROUP_ID": "cdb8acf4-564f-4cb1-923a-60a765a20b26"
        }
      }
    }
  }
}
