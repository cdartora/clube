{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clube",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public"
  },
  // Produção não tem preview URLs: elas usariam o banco de produção. Previews ficam no staging.
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clube",
      "database_id": "6e007bfa-35f5-4509-855c-844af898c38b",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    // Preenchidos quando o Access for configurado (passo 9). Vazios = modo local com DEV_USER_EMAIL.
    "ACCESS_TEAM_DOMAIN": "",
    // AUD Tag da aplicação do Access. Se houver mais de uma (ex.: workers.dev e preview URLs), separe por vírgula.
    "ACCESS_AUD": "",
    // Grupo do Access cujos emails podem entrar; os convites adicionam e removem emails dele.
    // O token (CF_API_TOKEN) é segredo: `npx wrangler secret put CF_API_TOKEN`.
    "CF_ACCOUNT_ID": "",
    "ACCESS_GROUP_ID": ""
  },
  "observability": {
    "enabled": true
  },
  "env": {
    // Staging: Worker `clube-staging`, com banco e grupo do Access próprios. Veja docs/deploy.md.
    // `vars` e `d1_databases` não são herdados do topo, então são repetidos aqui.
    "staging": {
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clube-staging",
          // Troque pelo ID que `npx wrangler d1 create clube-staging` mostrar.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "CF_ACCOUNT_ID": "",
        // Grupo separado (ex.: clube-staging): convites feitos no staging não liberam ninguém na produção.
        "ACCESS_GROUP_ID": ""
      },
      // Previews (`wrangler preview --env staging`, uma por branch). Não herdam nada de cima:
      // repetem o banco e as variáveis do staging. Mantenha os valores iguais aos de `env.staging`.
      "previews": {
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "clube-staging",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "drizzle/migrations"
          }
        ],
        "vars": {
          "ACCESS_TEAM_DOMAIN": "",
          "ACCESS_AUD": "",
          "CF_ACCOUNT_ID": "",
          "ACCESS_GROUP_ID": ""
        }
      }
    }
  }
}
