{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clube",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clube",
      "database_id": "6e007bfa-35f5-4509-855c-844af898c38b",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    // Preenchidos quando o Access for configurado (passo 9). Vazios = modo local com DEV_USER_EMAIL.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": {
    "enabled": true
  }
}
